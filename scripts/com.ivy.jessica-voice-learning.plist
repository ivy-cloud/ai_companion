<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly idle voice learning for ai_companion.
  Install: ./scripts/install_idle_learning.sh
  Runs only when Mac idle >= 20 min (see idle_voice_learning.sh).
  Up to ~24 learning windows/day when laptop is on but unused.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ivy.jessica-voice-learning</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_ROOT/scripts/idle_voice_learning.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>REPO_ROOT/docs/voice-learning-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_ROOT/docs/voice-learning-launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VOICE_LEARNING_MIN_IDLE_SEC</key>
    <string>1200</string>
    <key>VOICE_LEARNING_LOOKBACK_HOURS</key>
    <string>6</string>
  </dict>
</dict>
</plist>
