OLLAMA_BASE_URL=http://localhost:11434
# Default: Qwen 3B (fastest Qwen; good for voice). Alternatives: qwen2.5:7b, llama3.2:3b
OLLAMA_MODEL=qwen2.5:3b

# Fallback date/time when the app does not send a timezone (IANA). The phone sends
# its own zone on each /chat request; this is only used without that.
COMPANION_TIMEZONE=America/Los_Angeles

# Live web lookup for factual questions (Mac must be online). Two-step: search → grounded answer.
# Modes: always | questions | smart | off
WEB_SEARCH_MODE=always
# Optional: Tavily API key improves answer quality for any topic
# TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Optional better search (https://tavily.com) — if set, used instead of DuckDuckGo:
# TAVILY_API_KEY=

# Azure Speech (Neural TTS + voice input STT) — same key/region for both
# https://portal.azure.com → Speech service → Keys and endpoint
# This file must live in ai-backend/ (same folder as main.py).
AZURE_SPEECH_KEY=your_speech_subscription_key
# MUST match "Location / Region" on the same resource's Keys and endpoint page (lowercase).
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural

# Warmer delivery: neural speaking style + prosody. Set AZURE_USE_SPEAKING_STYLE=false if Azure returns 400.
AZURE_USE_SPEAKING_STYLE=true
# For Jenny try: friendly, chat, assistant, customerservice (see Azure "voice styles" docs).
AZURE_SPEAKING_STYLE=friendly
# Optional richer MP3, e.g. audio-48khz-192kbitrate-mono-mp3
# AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-160kbitrate-mono-mp3

# SSML prosody rate: multiplier 1.0 = normal (natural range ~0.95–1.02), or use % like +5%
# AZURE_SPEECH_RATE_MAIN=1.0
# AZURE_SPEECH_RATE_FILLER=1.0
# AZURE_SPEECH_RATE_MAIN=0.98
# AZURE_SPEECH_RATE_MAIN=1.02
# AZURE_SPEECH_PITCH_MAIN=+0.45st
# AZURE_SPEECH_PITCH_FILLER=+0.1st

# If you still get HTTP 401: wrong key OR region ≠ resource location. Do not use a key
# from another Azure service. Multi-service "Azure AI services" keys still need this region.

# Optional: override TTS host (default is https://{AZURE_SPEECH_REGION}.tts.speech.microsoft.com/...).
# AZURE_SPEECH_ENDPOINT=https://westus.tts.speech.microsoft.com

# Alternative names (Azure Speech SDK style):
# SPEECH_KEY=
# SPEECH_REGION=
